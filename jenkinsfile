pipeline{
    agent any
    environment{
        AWS_REGION = 'ap-south-1'
        ACCOUNT_ID = '174376948569'
        REPOSITORY = 'frontend'
        IMAGE_TAG = '${BUILD_NUMBER}'
        ECR_URI = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${REPOSITORY}:${IMAGE_TAG}"
        CLUSTER_NAME = 'demo-cluster'
        SERVICE_NAME = 'frontend'
        NAMESPACE = 'development'


    }
    stages{
        stage('Checkout'){
            steps{
                checkout scm
            }
        }
        stage('Build Docker Image'){
            steps{
                sh """
                docker build  -f docker/dockerfile -t ${REPOSITORY}:${IMAGE_TAG} .
                """
            }
        }
        stage('Login to AWS ECR'){
            steps {
                sh """
                aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                """   
                }
            }
        }

        stage('Tag and Push Docker Image to ECR'){
            steps{
                sh """
                docker tag ${REPOSITORY}:${IMAGE_TAG} ${ECR_URI}
                docker tag ${REPOSITORY}:${IMAGE_TAG} ${ECR_URI}:latest
                docker push ${ECR_URI}
                docker push ${ECR_URI}:latest
                """
            }
        }
        stage('Configure kubectl'){
            steps{
                sh """
                aws eks update-kubeconfig --region ${AWS_REGION} --name ${CLUSTER_NAME}
                kubectl config set-context --current --namespace=${K8S_NAMESPACE}
                """
            }
        }
        stage('Deploy to EKS Service'){
            steps{
                sh """
                kubectl set image deployment/${SERVICE_NAME} ${SERVICE_NAME}=${ECR_URI} --record
                kubectl rollout status deployment/${SERVICE_NAME} -n ${NAMESPACE} --timeout=300s;
                """
            }
        }
        stage('Verify Deployment'){
            steps{
                sh """
                kubectl get pods -n ${K8SNAMESPACE}
                kubectl get svc -n ${K8S_NAMESPACE}
                kubectl get ingress -n ${K8S_NAMESPACE}
                kubectl get deployment -n ${K8S_NAMESPACE}
                """
            }
        }
    }
    post{
        success{
            echo "Deployment Successful!"
            cleanWs()
            sh 'docker image prune -f'
        }
        failure{
            echo "Deployment Failed!"
            cleanWs()
        }
    }
}